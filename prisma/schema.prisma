// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // Bu 6543 olan (Normal çalışma için)
  directUrl = env("DIRECT_URL")     // Bu 5432 olan (Migration için KRİTİK!)
}

model User {
  id                    Int           @id @default(autoincrement())
  email                 String        @unique
  hash                  String        // 🎯 auth.service.ts ile uyumlu hale getirildi
  fullName              String        // 🎯 Eksik olan fullName alanı eklendi
  shopName              String
  category              String?       // 🎯 İşletme kategorisi (Berber, Kuaför vb.)
  slug                  String?       @unique
  phone                 String?       @unique
  tagline               String?
  description           String?
  logo                  String?
  coverImage            String?
  city                  String?
  district              String?
  addressTitle          String?
  fullAddress           String?
  address               String?
  googleMapsUrl         String?
  workStart             String        @default("09:00")
  workEnd               String        @default("20:00")
  instagram             String?
  facebook              String?
  twitter               String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // WP Şablonları & Doğrulama
  msgTemplateOnay       String?       @default("Merhaba {musteri_adi}, {salon_adi} için {tarih} {saat} randevunuz onaylanmıştır.")
  msgTemplateIptal      String?       @default("Merhaba {musteri_adi}, {tarih} {saat} randevunuz iptal edilmiştir.")
  msgTemplateHatirlatma String?       @default("Hatırlatma: {salon_adi} için {tarih} {saat} randevunuz yaklaşıyor.")
  
  verificationCode      String?
  isVerified            Boolean       @default(false)
  resetCode             String?
  resetCodeExpires      DateTime?

  // İlişkiler (Aşağıdaki modellere bağlanıyor)
  services              Service[]
  appointments          Appointment[]
  customers             Customer[]
  reviews               Review[]
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id          Int      @id @default(autoincrement())
  customerName String
  customerPhone String
  date        DateTime
  time        String
  status      String   @default("pending")
  notes       String?
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  serviceId   Int
  service     Service  @relation(fields: [serviceId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  notes       String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id          Int      @id @default(autoincrement())
  customerName String
  rating      Int
  comment     String?
  isPublished Boolean  @default(true)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}