// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  hash              String
  fullName          String
  shopName          String
  category          String?
  slug              String?   @unique
  phone             String?   @unique
  tagline           String?
  description       String?
  logo              String?
  coverImage        String?
  city              String?
  district          String?
  addressTitle      String?
  fullAddress       String?
  address           String?   // 🎯 KRİTİK: shop.service.ts:23 hatasını çözer
  googleMapsUrl     String?
  workStart         String   @default("09:00")
  workEnd           String   @default("20:00")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  isActive          Boolean   @default(true)
  isAdmin           Boolean   @default(false)
  isPromoted        Boolean   @default(false)
  instagram         String?
  plan              String    @default("TRIAL")
  trialEndsAt       DateTime?
  subscriptionEnd   DateTime?

  msgTemplateOnay   String?   @default("Merhaba {musteri_adi}, {salon_adi} için {tarih} {saat} randevunuz onaylanmıştır.")
  msgTemplateIptal  String?   @default("Merhaba {musteri_adi}, {tarih} {saat} randevunuz iptal edilmiştir.")
  msgTemplateHatirlatma String? @default("Hatırlatma: {salon_adi} için {tarih} {saat} randevunuz yaklaşıyor.")
  
  verificationCode  String?
  isVerified        Boolean   @default(false)
  resetCode         String?
  resetCodeExpires  DateTime?

  services      Service[]
  appointments  Appointment[]
  customers     Customer[]
  reviews       Review[]
  staff         Staff[]
  galleryItems  GalleryItem[]
  shopClosures  ShopClosure[]
  staffLeaves   StaffLeave[]
}

model Staff {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  role        String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
  leaves      StaffLeave[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  duration    Int
  isActive    Boolean  @default(true)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model Appointment {
  id            Int      @id @default(autoincrement())
  // 🎯 KRİTİK: public.service.ts:238 hatasını çözmek için bu 4 alan opsiyonel yapıldı (?)
  customerName  String?
  customerPhone String?
  date          DateTime?
  time          String?
  
  dateTime      DateTime @default(now())
  status        String   @default("pending")
  notes         String?
  isReminderSent Boolean @default(false)
  
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  
  serviceId     Int
  service       Service  @relation(fields: [serviceId], references: [id])

  customerId    Int?
  // 🎯 KRİTİK: reminder.service.ts:57 hatasını (possibly null) çözmek için '?' kaldırıldı
  customer      Customer @relation(fields: [customerId], references: [id])

  staffId       Int?
  staff         Staff?   @relation(fields: [staffId], references: [id])
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String
  notes       String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryItem {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  title       String?
  modelName   String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model ShopClosure {
  id        Int      @id @default(autoincrement())
  reason    String?
  date      DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model StaffLeave {
  id        Int      @id @default(autoincrement())
  date      DateTime
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  staffId   Int
  staff     Staff    @relation(fields: [staffId], references: [id])
}

model Review {
  id           Int      @id @default(autoincrement())
  customerName String
  rating       Int
  comment      String?
  isPublished  Boolean  @default(true)
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
}